{
  "name": "pelers",
  "version": "1.0.0-alpha2",
  "description": "Fast Mermaid renderer to themeable SVG for Node.js, Bun and browsers. A Rust port of Pele.",
  "license": "MIT OR Apache-2.0",
  "author": "Farhan Kurnia Pratama <farhnkrnapratma@gmail.com>",
  "keywords": [
    "mermaid",
    "diagram",
    "diagrams",
    "flowchart",
    "svg",
    "renderer"
  ],
  "homepage": "https://github.com/farhnkrnapratma/pelers#readme",
  "bugs": {
    "url": "https://github.com/farhnkrnapratma/pelers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhnkrnapratma/pelers.git"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    },
    "./lazy": {
      "types": "./lazy.d.ts",
      "default": "./lazy.js"
    },
    "./small": {
      "types": "./index.d.ts",
      "default": "./small.js"
    },
    "./small/lazy": {
      "types": "./lazy.d.ts",
      "default": "./small-lazy.js"
    },
    "./global": "./dist/pelers.global.js",
    "./small/global": "./dist/pelers.small.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.native.js",
    "index.d.ts",
    "index.native.d.ts",
    "browser.js",
    "lazy.js",
    "lazy.d.ts",
    "small.js",
    "small-lazy.js",
    "js/",
    "wasm/",
    "dist/pelers.global.js",
    "dist/pelers.small.global.js",
    "README.md",
    "NOTICE",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "bash .githooks/install.sh",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "build": "napi build --platform --features napi --esm --js index.native.js --dts index.native.d.ts",
    "build:release": "bun scripts/build-native.mjs",
    "test:bindings": "bun scripts/test-bindings.mjs",
    "test:native": "bun run build:release && bun run test:bindings",
    "build:wasm": "bun scripts/build-wasm.mjs",
    "test:dom": "bun test tests/dom",
    "prepublishOnly": "napi create-npm-dirs && napi pre-publish -t npm && bun run build:wasm"
  },
  "napi": {
    "binaryName": "pelers",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "powerpc64le-unknown-linux-gnu",
      "s390x-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "i686-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@napi-rs/cli": "^3.10.12",
    "fallow": "^3.46.0"
  },
  "browser": {
    "./index.js": "./browser.js"
  }
}
