{
  "name": "pelers",
  "version": "1.0.0-alpha1",
  "description": "A fast, lightweight Mermaid renderer that outputs themeable SVG (derived from Pele; Rust port in progress).",
  "license": "MIT OR Apache-2.0",
  "author": "Farhan Kurnia Pratama <farhnkrnapratma@gmail.com>",
  "keywords": [
    "mermaid",
    "diagram",
    "diagrams",
    "flowchart",
    "svg",
    "renderer"
  ],
  "homepage": "https://github.com/farhnkrnapratma/pelers#readme",
  "bugs": {
    "url": "https://github.com/farhnkrnapratma/pelers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhnkrnapratma/pelers.git"
  },
  "type": "module",
  "main": "./dist/pele.js",
  "module": "./dist/pele.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pele.js",
      "default": "./dist/pele.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/esm/core.js",
      "default": "./dist/esm/core.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/esm/lazy.js",
      "default": "./dist/esm/lazy.js"
    },
    "./diagrams/*": {
      "types": "./dist/entries/*.d.ts",
      "import": "./dist/esm/diagrams/*.js",
      "default": "./dist/esm/diagrams/*.js"
    },
    "./global": "./dist/pele.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "./dist/pele.js",
    "./src/index.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/website/**\"",
    "test:website": "vitest run tests/website",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:watch": "vitest --exclude \"tests/website/**\"",
    "bench": "node scripts/bench.mjs",
    "bench:mermaid": "node scripts/bench-mermaid.mjs",
    "website": "cd website && pnpm dev",
    "prepare": "bash .githooks/install.sh",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@mermaid-js/parser": "^2.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "beautiful-mermaid": "^1.1.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jison": "^0.4.18",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "underscore": "^1.13.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
