  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "generate": "bun scripts/render-examples.ts",
    "dev": "bun run generate && vite dev",
